# Application
NODE_ENV=development
PORT=3000

# Database
# DB_URL is preferred. MONGO_URI is also supported for compatibility.
DB_URL=mongodb://localhost:27017/luxe_scents
# MONGO_URI=mongodb://localhost:27017/luxe_scents

# Sessions and cookies
SESSION_SECRET=YOUR_SESSION_SECRET
# Optional override. Production defaults to secure cookies when NODE_ENV=production.
SESSION_COOKIE_SECURE=false

# Optional CSRF secret. Defaults to SESSION_SECRET when blank.
CSRF_SECRET=

# Optional. Set this only if you want /health enabled in production.
HEALTH_TOKEN=

# Optional local seeding only. Do not use production account passwords.
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# SafePay (sandbox). Leave blank to hide the "Pay Online" option at checkout.
# Get free sandbox keys at https://getsafepay.pk/signup — no documents needed for testing.
SAFEPAY_ENV=sandbox
SAFEPAY_API_KEY=
SAFEPAY_V1_SECRET=
SAFEPAY_WEBHOOK_SECRET=
# Optional. Used for SafePay redirect URLs. Defaults to the request host when blank.
# APP_URL=https://luxe-scents.onrender.com
